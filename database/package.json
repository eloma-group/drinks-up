{
  "name": "drinksup-database",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Drinks Up PostgreSQL schema, seed data and local development database",
  "scripts": {
    "dev": "tsx scripts/dev-db.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx seed/seed.ts",
    "reset": "tsx scripts/migrate.ts --reset && tsx seed/seed.ts",
    "reset:dev": "tsx scripts/recreate-dev.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.7.0-beta.19",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
