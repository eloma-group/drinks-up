# Copy to .env for local development (defaults below already work with `npm run dev` in database/)
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5433/drinksup
# Azure Database for PostgreSQL: postgres://USER:PASSWORD@SERVER.postgres.database.azure.com:5432/drinksup and DATABASE_SSL=true
DATABASE_SSL=false
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
SHOPIFY_STORE_URL=https://drinksup.com.au
PUBLIC_URL=
# Optional: product image uploads to Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=product-images
